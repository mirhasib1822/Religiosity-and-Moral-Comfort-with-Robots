# Function to generate a simple report
generate_simple_report <- function() {
  report_file <- "SEM_Analysis_Report.txt"
  
  cat("STRUCTURAL EQUATION MODELING ANALYSIS REPORT\n", file = report_file)
  cat("=============================================\n\n", file = report_file, append = TRUE)
  
  cat("Analysis Date:", date(), "\n\n", file = report_file, append = TRUE)
  
  cat("MODEL FIT INDICES:\n", file = report_file, append = TRUE)
  cat("-----------------\n", file = report_file, append = TRUE)
  for(i in 1:nrow(fit_table)) {
    cat(sprintf("%-25s: %s\n", fit_table$Index[i], fit_table$Value[i]), 
        file = report_file, append = TRUE)
  }
  
  cat("\n\nSIGNIFICANT STRUCTURAL PATHS (p < .05):\n", file = report_file, append = TRUE)
  cat("----------------------------------------\n", file = report_file, append = TRUE)
  
  sig_paths <- sem_params_complete %>%
    filter(op == "~" & pvalue < 0.05)
  
  if(nrow(sig_paths) > 0) {
    for(i in 1:nrow(sig_paths)) {
      cat(sprintf("%s → %s: β = %.3f, p = %.4f\n",
                  sig_paths$rhs[i], sig_paths$lhs[i],
                  sig_paths$std.all[i], sig_paths$pvalue[i]),
          file = report_file, append = TRUE)
    }
  } else {
    cat("No significant structural paths found.\n", file = report_file, append = TRUE)
  }
  
  cat("\n\nSIGNIFICANT INDIRECT EFFECTS (p < .05):\n", file = report_file, append = TRUE)
  cat("----------------------------------------\n", file = report_file, append = TRUE)
  
  sig_indirect <- sem_params_complete %>%
    filter(op == ":=" & pvalue < 0.05)
  
  if(nrow(sig_indirect) > 0) {
    for(i in 1:nrow(sig_indirect)) {
      cat(sprintf("%s: β = %.3f, p = %.4f\n",
                  sig_indirect$lhs[i],
                  sig_indirect$std.all[i], sig_indirect$pvalue[i]),
          file = report_file, append = TRUE)
    }
  } else {
    cat("No significant indirect effects found.\n", file = report_file, append = TRUE)
  }
  
  cat("\n\nR-SQUARED VALUES:\n", file = report_file, append = TRUE)
  cat("----------------\n", file = report_file, append = TRUE)
  rsquared_vals <- inspect(fit_sem, "r2")
  for(i in 1:length(rsquared_vals)) {
    cat(sprintf("%-30s: R² = %.3f (%.1f%%)\n",
                names(rsquared_vals)[i],
                rsquared_vals[i], rsquared_vals[i] * 100),
        file = report_file, append = TRUE)
  }
  
  cat("\n\nFILES GENERATED:\n", file = report_file, append = TRUE)
  cat("---------------\n", file = report_file, append = TRUE)
  cat("1. SEM_Measurement_Model.csv\n", file = report_file, append = TRUE)
  cat("2. SEM_Structural_Paths.csv\n", file = report_file, append = TRUE)
  cat("3. SEM_Indirect_Effects.csv\n", file = report_file, append = TRUE)
  cat("4. SEM_Fit_Indices.csv\n", file = report_file, append = TRUE)
  cat("5. SEM_Path_Diagram.png\n", file = report_file, append = TRUE)
  cat("6. SEM_Coefficient_Plot.png\n", file = report_file, append = TRUE)
  cat("7. SEM_Indirect_Effects_Plot.png\n", file = report_file, append = TRUE)
  cat("8. SEM_Rsquared_Plot.png\n", file = report_file, append = TRUE)
  
  cat("\nSimple report saved to '", report_file, "'\n", sep="")
}

