cat("\n=== Creating Multi-Group SEM Diagram ===\n")

# Create a simplified SEM diagram showing group differences
create_sem_diagram <- function() {
  # Create a data frame for the visualization
  diagram_data <- data.frame(
    Group = factor(rep(c("Gender 0", "Gender 1", "High Relig", "Low Relig"), each = 2)),
    Path = rep(c("IR → Anthro", "Anthro → Neg"), 4),
    Beta = c(0.588, 0.142, 0.124, 0.120, 0.677, 0.124, -0.430, 0.141),
    PathType = rep(c("First Stage", "Second Stage"), 4)
  )
  
  p <- ggplot(diagram_data, aes(x = PathType, y = Beta, color = Group, group = Group)) +
    geom_line(size = 1.5, alpha = 0.7) +
    geom_point(size = 4) +
    geom_text(aes(label = round(Beta, 3)), vjust = -1, size = 3.5) +
    scale_color_manual(values = c("Gender 0" = "#1f77b4", "Gender 1" = "#ff7f0e",
                                  "High Relig" = "#2ca02c", "Low Relig" = "#d62728")) +
    labs(title = "Multi-Group SEM: Key Path Differences",
         subtitle = "Comparison of Anthropomorphism Pathway Across Groups",
         x = "Path Stage",
         y = "Standardized Beta Coefficient") +
    theme_minimal() +
    theme(
      legend.position = "bottom",
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      panel.grid.major = element_line(color = "gray90"),
      panel.grid.minor = element_blank()
    ) +
    ylim(-0.5, 0.8)
  
  return(p)
}

