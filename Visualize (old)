# Create comparison plot for each grouping variable
create_path_comparison_plot <- function(group_label) {
  path_data <- extract_path_coefficients(group_label)
  
  # Add significance stars
  path_data$Significance <- ifelse(path_data$pvalue < 0.001, "***",
                                   ifelse(path_data$pvalue < 0.01, "**",
                                          ifelse(path_data$pvalue < 0.05, "*", "")))
  
  # Create the plot
  p <- ggplot(path_data, aes(x = Path, y = Beta, fill = Group)) +
    geom_bar(stat = "identity", position = position_dodge(width = 0.7), width = 0.6) +
    geom_text(aes(label = Significance, y = Beta + ifelse(Beta >= 0, 0.02, -0.02)), 
              position = position_dodge(width = 0.7), size = 4) +
    scale_fill_manual(values = c("Gender 0" = "#1f77b4", "Gender 1" = "#ff7f0e",
                                 "High Relig" = "#2ca02c", "Low Relig" = "#d62728",
                                 "Older" = "#9467bd", "Younger" = "#8c564b")) +
    labs(title = paste("Path Coefficients by", group_label),
         subtitle = "Standardized Beta Coefficients",
         x = "Structural Path",
         y = "Standardized Beta") +
    theme_minimal() +
    theme(
      axis.text.x = element_text(angle = 45, hjust = 1),
      legend.position = "bottom",
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12)
    ) +
    geom_hline(yintercept = 0, linetype = "dashed", color = "gray40")
  
  return(p)
}

