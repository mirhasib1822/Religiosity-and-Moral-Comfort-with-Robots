cat("\n=== Creating Side-by-Side Group Comparison ===\n")

# Create a comprehensive comparison figure
create_comprehensive_comparison <- function() {
  
  # Prepare data for all groups
  all_groups_data <- data.frame(
    Group = factor(rep(c("Gender 0", "Gender 1", "High Relig", "Low Relig", 
                         "Older", "Younger"), each = 6),
                   levels = c("Gender 0", "Gender 1", "High Relig", "Low Relig", 
                              "Older", "Younger")),
    Path = rep(c("IR → Anthro", "Anthro → Neg", "IR → Like", "Like → Neg",
                 "IR → Disgust", "Disgust → Neg"), 6),
    Beta = c(
      0.588, 0.142, 0.041, -0.021, 0.021, 0.284,
      0.124, 0.120, -0.111, -0.036, 0.000, 0.354,
      0.677, 0.124, -0.148, -0.034, 0.033, 0.357,
      -0.430, 0.141, 0.114, -0.030, -0.007, 0.301,
      0.605, 0.132, -0.005, -0.023, 0.008, 0.254,
      0.108, 0.146, -0.065, -0.041, 0.014, 0.406
    )
  )
  
  # Create facet plot
  p <- ggplot(all_groups_data, aes(x = Path, y = Beta, fill = Beta > 0)) +
    geom_bar(stat = "identity", width = 0.7) +
    facet_wrap(~ Group, ncol = 2) +
    scale_fill_manual(values = c("TRUE" = "#d62728", "FALSE" = "#1f77b4"),
                      guide = "none") +
    labs(title = "Comprehensive Comparison of Structural Paths Across Groups",
         subtitle = "Standardized Beta Coefficients for All Demographic Groups",
         x = "Structural Path",
         y = "Standardized Beta") +
    theme_minimal() +
    theme(
      axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
      strip.text = element_text(face = "bold", size = 10),
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      panel.spacing = unit(1, "lines")
    ) +
    geom_hline(yintercept = 0, linetype = "dashed", color = "gray40")
  
  return(p)
}

p_comprehensive <- create_comprehensive_comparison()
print(p_comprehensive)
ggsave("Comprehensive_Group_Comparison.png", p_comprehensive, width = 14, height = 10, dpi = 300)

