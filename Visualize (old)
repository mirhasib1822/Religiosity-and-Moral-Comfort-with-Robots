cat("\n=== Creating Heatmap of Group Differences ===\n")

create_heatmap <- function() {
  # Create heatmap data
  heatmap_data <- expand.grid(
    Group = c("Gender 0", "Gender 1", "High Relig", "Low Relig", "Older", "Younger"),
    Path = c("IR → Anthro", "IR → Like", "IR → Disgust", 
             "Anthro → Neg", "Like → Neg", "Disgust → Neg")
  )
  
  # Add beta values (simplified for demonstration)
  set.seed(123)
  heatmap_data$Beta <- c(
    0.588, 0.041, 0.021, 0.142, -0.021, 0.284,  # Gender 0
    0.124, -0.111, 0.000, 0.120, -0.036, 0.354, # Gender 1
    0.677, -0.148, 0.033, 0.124, -0.034, 0.357, # High Relig
    -0.430, 0.114, -0.007, 0.141, -0.030, 0.301, # Low Relig
    0.605, -0.005, 0.008, 0.132, -0.023, 0.254, # Older
    0.108, -0.065, 0.014, 0.146, -0.041, 0.406  # Younger
  )
  
  # Create heatmap
  p <- ggplot(heatmap_data, aes(x = Path, y = Group, fill = Beta)) +
    geom_tile(color = "white", size = 0.5) +
    geom_text(aes(label = round(Beta, 3)), color = "black", size = 3) +
    scale_fill_gradient2(low = "blue", mid = "white", high = "red",
                         midpoint = 0, limits = c(-0.5, 0.7),
                         name = "Beta\nCoefficient") +
    labs(title = "Heatmap of Standardized Path Coefficients",
         subtitle = "Comparison Across Demographic Groups",
         x = "Structural Path",
         y = "Demographic Group") +
    theme_minimal() +
    theme(
      axis.text.x = element_text(angle = 45, hjust = 1, size = 10),
      axis.text.y = element_text(size = 10),
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      legend.position = "right"
    )
  
  return(p)
}

p_heatmap <- create_heatmap()
print(p_heatmap)
ggsave("Group_Differences_Heatmap.png", p_heatmap, width = 11, height = 7, dpi = 300)

