cat("\n=== 6.5 INDIRECT EFFECTS VISUALIZATION ===\n")

create_simple_indirect_plot <- function() {
  # Extract indirect effects
  indirect_data <- sem_params_complete %>%
    filter(op == ":=") %>%
    mutate(
      Effect_Type = case_when(
        grepl("disgust", lhs, ignore.case = TRUE) ~ "Disgust Pathway",
        grepl("anthro", lhs, ignore.case = TRUE) ~ "Anthropomorphism Pathway",
        grepl("total", lhs, ignore.case = TRUE) ~ "Total",
        TRUE ~ "Other"
      )
    )
  
  # Create simple indirect effects plot
  p <- ggplot(indirect_data, aes(x = est, y = reorder(lhs, est), fill = Effect_Type)) +
    geom_col(width = 0.6) +
    geom_text(aes(label = round(est, 3)), 
              hjust = ifelse(indirect_data$est >= 0, -0.2, 1.2), 
              size = 3.5) +
    scale_fill_manual(values = c("Disgust Pathway" = "#d62728", 
                                 "Anthropomorphism Pathway" = "#1f77b4",
                                 "Total" = "#2ca02c",
                                 "Other" = "#9467bd")) +
    labs(title = "Indirect Effects in Dual-Path Model",
         subtitle = "Mediation Effects of Anthropomorphism and Disgust",
         x = "Indirect Effect Size",
         y = "Effect") +
    theme_minimal() +
    theme(
      legend.position = "bottom",
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      axis.text.y = element_text(size = 10),
      panel.grid.major = element_line(color = "gray90"),
      panel.grid.minor = element_blank()
    )
  
  return(p)
}

