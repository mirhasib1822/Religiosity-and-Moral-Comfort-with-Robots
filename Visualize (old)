# Create a conceptual diagram
create_conceptual_diagram <- function() {
  # Create node positions
  nodes <- data.frame(
    name = c("Intrinsic\nReligiosity", "Anthropomorphism", "Likeability", "Disgust\nSensitivity", 
             "Negative\nRobot\nPerceptions"),
    x = c(1, 2, 2, 2, 3),
    y = c(3, 4, 3, 2, 3)
  )
  
  # Create edges with group-specific effects
  edges <- data.frame(
    from = c("Intrinsic\nReligiosity", "Intrinsic\nReligiosity", "Intrinsic\nReligiosity",
             "Anthropomorphism", "Likeability", "Disgust\nSensitivity"),
    to = c("Anthropomorphism", "Likeability", "Disgust\nSensitivity",
           "Negative\nRobot\nPerceptions", "Negative\nRobot\nPerceptions", "Negative\nRobot\nPerceptions"),
    gender0 = c("β=.59***", "β=.04", "β=.02*", "β=.14***", "β=-.02", "β=.28"),
    gender1 = c("β=.12**", "β=-.11", "β=.00", "β=.12***", "β=-.04*", "β=.35*"),
    high_relig = c("β=.68***", "β=-.15", "β=.03*", "β=.12***", "β=-.03*", "β=.36*"),
    low_relig = c("β=-.43*", "β=.11", "β=-.01", "β=.14***", "β=-.03*", "β=.30*")
  )
  
  # Create the plot
  p <- ggplot() +
    # Add nodes
    geom_point(data = nodes, aes(x = x, y = y), size = 20, color = "lightblue", fill = "lightblue", shape = 21) +
    geom_text(data = nodes, aes(x = x, y = y, label = name), size = 3.5, fontface = "bold") +
    
    # Add edges (simplified for visualization)
    geom_segment(aes(x = 1.2, y = 3, xend = 1.8, yend = 4), arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#d62728") +
    geom_segment(aes(x = 1.2, y = 3, xend = 1.8, yend = 2), arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#2ca02c") +
    geom_segment(aes(x = 2.2, y = 4, xend = 2.8, yend = 3), arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#ff7f0e") +
    geom_segment(aes(x = 2.2, y = 2, xend = 2.8, yend = 3), arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#9467bd") +
    
    # Add legend for group differences
    annotate("text", x = 0.5, y = 4.5, label = "Group Differences:", hjust = 0, fontface = "bold", size = 4) +
    annotate("text", x = 0.5, y = 4.2, label = "Red: Strong in Gender 0 & High Relig", hjust = 0, color = "#d62728", size = 3) +
    annotate("text", x = 0.5, y = 4.0, label = "Green: Disgust pathway", hjust = 0, color = "#2ca02c", size = 3) +
    annotate("text", x = 0.5, y = 3.8, label = "Orange: Anthro → Neg path", hjust = 0, color = "#ff7f0e", size = 3) +
    annotate("text", x = 0.5, y = 3.6, label = "Purple: Age differences", hjust = 0, color = "#9467bd", size = 3) +
    
    # Set limits and theme
    xlim(0.5, 3.5) +
    ylim(1.5, 4.5) +
    theme_void() +
    labs(title = "Dual-Path Model with Group Differences",
         subtitle = "Visualization of Key Group-Specific Effects") +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
      plot.subtitle = element_text(hjust = 0.5, size = 12)
    )
  
  return(p)
}

