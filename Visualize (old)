cat("\n=== 6.4 SIMPLE COEFFICIENT PLOT ===\n")

create_simple_coefficient_plot <- function() {
  # Prepare data for coefficient plot
  coef_data <- sem_params_complete %>%
    filter(op == "~") %>%
    mutate(
      Path = paste(rhs, "→", lhs),
      Significance = ifelse(pvalue < 0.001, "p < .001",
                           ifelse(pvalue < 0.01, "p < .01",
                                  ifelse(pvalue < 0.05, "p < .05", "ns")))
    ) %>%
    arrange(std.all)
  
  # Create simple coefficient plot
  p <- ggplot(coef_data, aes(x = std.all, y = reorder(Path, std.all))) +
    geom_col(aes(fill = ifelse(std.all > 0, "Positive", "Negative")), width = 0.6) +
    geom_text(aes(label = round(std.all, 3)), 
              hjust = ifelse(coef_data$std.all >= 0, -0.2, 1.2), 
              size = 3.5) +
    geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
    scale_fill_manual(values = c("Positive" = "#d62728", "Negative" = "#1f77b4")) +
    labs(title = "Standardized Path Coefficients",
         subtitle = "Dual-Path Model Structural Relationships",
         x = "Standardized Beta Coefficient",
         y = "Structural Path") +
    theme_minimal() +
    theme(
      legend.position = "none",
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      axis.text.y = element_text(size = 10),
      panel.grid.major = element_line(color = "gray90"),
      panel.grid.minor = element_blank()
    ) +
    xlim(min(coef_data$std.all) * 1.3, max(coef_data$std.all) * 1.3)
  
  return(p)
}

