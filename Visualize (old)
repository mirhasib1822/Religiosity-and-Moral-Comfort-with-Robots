cat("\n=== 6.6 R-SQUARED VALUES PLOT ===\n")

create_rsquared_plot <- function() {
  # Get R-squared values
  rsquared_vals <- inspect(fit_sem, "r2")
  
  # Prepare data
  rsquared_data <- data.frame(
    Variable = names(rsquared_vals),
    R2 = as.numeric(rsquared_vals),
    Type = ifelse(names(rsquared_vals) == "RobotNegativePerceptions", 
                  "Outcome", "Mediator")
  )
  
  # Create R-squared plot
  p <- ggplot(rsquared_data, aes(x = R2, y = reorder(Variable, R2), fill = Type)) +
    geom_col(width = 0.6) +
    geom_text(aes(label = paste0(round(R2 * 100, 1), "%")), 
              hjust = -0.2, size = 4) +
    scale_fill_manual(values = c("Outcome" = "#d62728", "Mediator" = "#1f77b4")) +
    labs(title = "R-squared Values for Endogenous Variables",
         subtitle = "Proportion of Variance Explained",
         x = "R-squared",
         y = "Variable") +
    theme_minimal() +
    theme(
      legend.position = "bottom",
      plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      axis.text.y = element_text(size = 10),
      panel.grid.major = element_line(color = "gray90"),
      panel.grid.minor = element_blank()
    ) +
    xlim(0, max(rsquared_data$R2) * 1.3)
  
  return(p)
}

