# Create enhanced SEM diagram
create_sem_path_diagram <- function() {
  
  # Create node data
  nodes <- data.frame(
    id = c("IR", "Anthro_Animacy1", "Anthro_Animacy2", "Likeability",
           "Disgust1", "Disgust2", "Disgust3", "RobotNegative"),
    label = c("Intrinsic\nReligiosity", "Anthro/\nAnimacy 1", "Anthro/\nAnimacy 2", 
              "Likeability", "Disgust\nFactor 1", "Disgust\nFactor 2", 
              "Disgust\nFactor 3", "Negative\nPerceptions"),
    type = c("exogenous", "mediator", "mediator", "mediator", 
             "mediator", "mediator", "mediator", "endogenous"),
    x = c(1, 2, 2, 2, 2, 2, 2, 3),
    y = c(3.5, 4.5, 3.5, 2.5, 5.5, 4.5, 3.5, 3.5)
  )
  
  # Create plot
  p <- ggplot() +
    # Add nodes with different shapes for different types
    geom_point(data = nodes, aes(x = x, y = y, shape = type, color = type), 
               size = 15, alpha = 0.8) +
    geom_text(data = nodes, aes(x = x, y = y, label = label), 
              size = 3, fontface = "bold", color = "black") +
    
    # Add path arrows (anthropomorphism pathway in blue)
    geom_segment(aes(x = 1.2, y = 3.5, xend = 1.8, yend = 4.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#1f77b4", alpha = 0.7) +
    geom_segment(aes(x = 1.2, y = 3.5, xend = 1.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#1f77b4", alpha = 0.7) +
    geom_segment(aes(x = 1.2, y = 3.5, xend = 1.8, yend = 2.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#1f77b4", alpha = 0.7) +
    
    # Disgust pathway (in red)
    geom_segment(aes(x = 1.2, y = 3.5, xend = 1.8, yend = 5.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#d62728", alpha = 0.7) +
    geom_segment(aes(x = 1.2, y = 3.5, xend = 1.8, yend = 4.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#d62728", alpha = 0.7) +
    geom_segment(aes(x = 1.2, y = 3.5, xend = 1.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#d62728", alpha = 0.7) +
    
    # Mediator to outcome paths
    geom_segment(aes(x = 2.2, y = 4.5, xend = 2.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#2ca02c", alpha = 0.7) +
    geom_segment(aes(x = 2.2, y = 3.5, xend = 2.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#2ca02c", alpha = 0.7) +
    geom_segment(aes(x = 2.2, y = 2.5, xend = 2.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#2ca02c", alpha = 0.7) +
    geom_segment(aes(x = 2.2, y = 5.5, xend = 2.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#ff7f0e", alpha = 0.7) +
    geom_segment(aes(x = 2.2, y = 4.5, xend = 2.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#ff7f0e", alpha = 0.7) +
    geom_segment(aes(x = 2.2, y = 3.5, xend = 2.8, yend = 3.5), 
                 arrow = arrow(length = unit(0.2, "cm")), 
                 size = 1, color = "#ff7f0e", alpha = 0.7) +
    
    # Add legend
    annotate("text", x = 0.8, y = 6, label = "Pathway Legend:", hjust = 0, fontface = "bold", size = 4) +
    annotate("text", x = 0.8, y = 5.8, label = "Blue: IR → Anthropomorphism", hjust = 0, color = "#1f77b4", size = 3.5) +
    annotate("text", x = 0.8, y = 5.6, label = "Red: IR → Disgust", hjust = 0, color = "#d62728", size = 3.5) +
    annotate("text", x = 0.8, y = 5.4, label = "Green: Anthropomorphism → Outcome", hjust = 0, color = "#2ca02c", size = 3.5) +
    annotate("text", x = 0.8, y = 5.2, label = "Orange: Disgust → Outcome", hjust = 0, color = "#ff7f0e", size = 3.5) +
    
    # Customize shapes and colors
    scale_shape_manual(values = c("exogenous" = 15, "mediator" = 16, "endogenous" = 17)) +
    scale_color_manual(values = c("exogenous" = "#9467bd", "mediator" = "#8c564b", "endogenous" = "#e377c2")) +
    
    # Set theme and labels
    theme_void() +
    theme(
      legend.position = "none",
      plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
      plot.subtitle = element_text(hjust = 0.5, size = 12)
    ) +
    labs(title = "Dual-Path Structural Equation Model",
         subtitle = "Religiosity → Anthropomorphism/Disgust → Negative Robot Perceptions") +
    xlim(0.5, 3.5) +
    ylim(2, 6.5)
  
  return(p)
}

