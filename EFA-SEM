  # valid_emp <- names(which(table(data_all$EmploymentStatus) > 50))
  # data_emp <- data_all[data_all$EmploymentStatus %in% valid_emp, ]
  
  run_invariance_analysis("EmploymentStatus", "Employment Status")
}

