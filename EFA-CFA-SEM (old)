# SIMPLIFIED MODEL FOR MULTI-GROUP ANALYSIS (better stability)
sem_model_simple <- '
# ==================== MEASUREMENT MODELS ====================
# Simplified factor structures
Anthropomorphism =~ IDAQ7 + IDAQ9 + IDAQ4 + IDAQ5 + IDAQ1
Likeability =~ IDAQ15 + IDAQ10 + IDAQ6 + IDAQ12 + IDAQ2
Disgust =~ DS.RPartI6 + DS.RPartI8 + DS.RPartII_19 + DS.RPartII_20

# ==================== STRUCTURAL MODEL ====================
# Religiosity -> Mediators
Anthropomorphism ~ IR
Likeability ~ IR
Disgust ~ IR

# Mediators -> Outcome
RobotNegativePerceptions ~ Anthropomorphism + Likeability + Disgust

# ==================== COVARIANCES ====================
Anthropomorphism ~~ Likeability
'

# Multi-group SEM function
run_multi_group_sem <- function(group_var, group_label) {
  cat(paste("\n", rep("=", 60), sep=""))
  cat(paste("\n--- Multi-Group SEM for:", group_label, "---\n"))
  cat(paste(rep("=", 60), "\n", sep=""))
  
  # Check group sizes
  group_table <- table(data_all_clean[[group_var]])
  cat("Group sizes:\n")
  print(group_table)
  
  # Keep only groups with sufficient sample size
  sufficient_groups <- names(group_table[group_table > 150])  # Increased for stability
  if(length(sufficient_groups) < 2) {
    cat("Insufficient groups for multi-group analysis (need at least 2 groups with n > 150)\n")
    return(NULL)
  }
  
  data_subset <- data_all_clean[data_all_clean[[group_var]] %in% sufficient_groups, ]
  data_subset[[group_var]] <- droplevels(as.factor(data_subset[[group_var]]))
  
  cat("Groups included in analysis:", paste(sufficient_groups, collapse = ", "), "\n")
  cat("Total sample size for this analysis:", nrow(data_subset), "\n")
  
  # Test measurement invariance first
  cat("\n--- MEASUREMENT INVARIANCE TESTING ---\n")
  
  tryCatch({
    # Configural invariance (same structure across groups)
    cat("Fitting configural model (same structure)...\n")
    configural <- sem(sem_model_simple, data = data_subset, group = group_var, 
                      estimator = "MLR", missing = "FIML")
    
    # Metric invariance (equal loadings across groups)
    cat("Fitting metric model (equal loadings)...\n")
    metric <- sem(sem_model_simple, data = data_subset, group = group_var,
                  group.equal = "loadings", estimator = "MLR", missing = "FIML")
    
    # Compare measurement invariance models
    cat("\n--- MEASUREMENT INVARIANCE COMPARISON ---\n")
    measurement_comparison <- lavTestLRT(configural, metric)
    print(measurement_comparison)
    
    # Use metric model if measurement invariance holds, otherwise use configural
    if(measurement_comparison$`Pr(>Chisq)`[2] > 0.05) {
      cat("Measurement invariance SUPPORTED - using metric model for structural tests\n")
      base_model <- metric
    } else {
      cat("Measurement invariance VIOLATED - using configural model for structural tests\n")
      base_model <- configural
    }
    
    # Test structural invariance for key paths
    cat("\n--- STRUCTURAL INVARIANCE TESTING ---\n")
    
    # Test invariance of religiosity effects
    cat("Testing invariance of religiosity effects...\n")
    structural_relig <- sem(sem_model_simple, data = data_subset, group = group_var,
                            group.equal = c("loadings", "regressions"), 
                            estimator = "MLR", missing = "FIML")
    
    relig_comparison <- lavTestLRT(base_model, structural_relig)
    cat("Religiosity effects invariance test:\n")
    print(relig_comparison)
    
    # Extract group-specific parameter estimates
    cat("\n--- GROUP-SPECIFIC STRUCTURAL PATHS ---\n")
    group_params <- parameterEstimates(base_model, standardized = TRUE)
    
    # Display key structural paths by group
    key_paths_to_examine <- c(
      "Anthropomorphism ~ IR", "Likeability ~ IR", "Disgust ~ IR",
      "RobotNegativePerceptions ~ Anthropomorphism", 
      "RobotNegativePerceptions ~ Likeability",
      "RobotNegativePerceptions ~ Disgust"
    )
    
    for(path in key_paths_to_examine) {
      cat(paste("\nPath:", path, "\n"))
      path_split <- strsplit(path, " ~ ")[[1]]
      lhs_var <- path_split[1]
      rhs_var <- path_split[2]
      
      path_data <- group_params[group_params$op == "~" & 
                                  group_params$lhs == lhs_var &
                                  group_params$rhs == rhs_var, ]
      
      if(nrow(path_data) > 0) {
        print(path_data[, c("group", "lhs", "op", "rhs", "est", "std.all", "pvalue")])
      } else {
        cat("No data found for this path\n")
      }
    }
    
  }, error = function(e) {
    cat("Error in multi-group analysis:", e$message, "\n")
    return(NULL)
  })
}

