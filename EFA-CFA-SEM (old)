# 3. STRUCTURAL EQUATION MODELING (SEM) - DUAL PATH MODEL
# =============================================================================

cat("\n", rep("=", 70), sep="")
cat("\nSTRUCTURAL EQUATION MODELING - TESTING DUAL-PATH MODEL")
cat("\n", rep("=", 70), "\n", sep="")

# Define the dual-path SEM model using validated factor structures
sem_model <- '
# ==================== MEASUREMENT MODELS ====================

# Anthropomorphism - 3 Factor Model (validated in CFA)
Anthro_Animacy1 =~ IDAQ7 + IDAQ9 + IDAQ4 + IDAQ5 + IDAQ1
Likeability =~ IDAQ15 + IDAQ10 + IDAQ6 + IDAQ12 + IDAQ2
Anthro_Animacy2 =~ IDAQ8 + IDAQ11 + IDAQ14 + IDAQ13 + IDAQ3

# Disgust Sensitivity - 3 Factor Model (validated in CFA)
Disgust1 =~ DS.RPartI6 + DS.RPartI8 + DS.RPartI13
Disgust2 =~ DS.RPartII_19 + DS.RPartII_20
Disgust3 =~ DS.RPartI9 + DS.RPartII_21

# ==================== STRUCTURAL MODEL ====================

# PATHWAY 1: Religiosity -> Disgust -> Negative Perceptions
Disgust1 ~ a11 * IR
Disgust2 ~ a12 * IR  
Disgust3 ~ a13 * IR
RobotNegativePerceptions ~ b11 * Disgust1 + b12 * Disgust2 + b13 * Disgust3

# PATHWAY 2: Religiosity -> Anthropomorphism -> Negative Perceptions
Anthro_Animacy1 ~ a21 * IR
Anthro_Animacy2 ~ a22 * IR
Likeability ~ a23 * IR
RobotNegativePerceptions ~ b21 * Anthro_Animacy1 + b22 * Anthro_Animacy2 + b23 * Likeability

# ==================== INDIRECT EFFECTS ====================

# Disgust Pathway Indirect Effects
indirect_disgust1 := a11 * b11
indirect_disgust2 := a12 * b12  
indirect_disgust3 := a13 * b13
total_indirect_disgust := a11*b11 + a12*b12 + a13*b13

# Anthropomorphism Pathway Indirect Effects
indirect_anthro1 := a21 * b21
indirect_anthro2 := a22 * b22
indirect_likeability := a23 * b23
total_indirect_anthro := a21*b21 + a22*b22 + a23*b23

# Total Indirect Effect
total_indirect := total_indirect_disgust + total_indirect_anthro

# ==================== COVARIANCES ====================

# Correlations among exogenous latent variables
Anthro_Animacy1 ~~ Anthro_Animacy2
Anthro_Animacy1 ~~ Likeability
Anthro_Animacy2 ~~ Likeability
Disgust1 ~~ Disgust2
Disgust1 ~~ Disgust3
Disgust2 ~~ Disgust3

# Correlations between disgust and anthropomorphism factors
Anthro_Animacy1 ~~ Disgust1 + Disgust2 + Disgust3
Anthro_Animacy2 ~~ Disgust1 + Disgust2 + Disgust3
Likeability ~~ Disgust1 + Disgust2 + Disgust3
'

cat("Fitting Dual-Path SEM Model...\n")
fit_sem <- sem(sem_model, data = data_all, estimator = "MLR", missing = "FIML")

# Model fit summary
cat("\n=== SEM MODEL FIT INDICES ===\n")
sem_fit_measures <- fitMeasures(fit_sem, 
                               c("chisq", "df", "pvalue", "cfi", "tli", "rmsea", "srmr", "aic", "bic"))
print(round(sem_fit_measures, 3))

# Detailed parameter estimates
cat("\n=== STRUCTURAL PATH COEFFICIENTS ===\n")
sem_params <- parameterEstimates(fit_sem, standardized = TRUE)

# Display structural paths (regression coefficients)
structural_paths <- sem_params[sem_params$op == "~", ]
structural_paths_clean <- structural_paths[, c("lhs", "op", "rhs", "est", "std.all", "pvalue")]
structural_paths_clean <- structural_paths_clean[order(structural_paths_clean$lhs, structural_paths_clean$rhs), ]
print(structural_paths_clean)

# Display indirect effects
cat("\n=== INDIRECT EFFECTS ===\n")
indirect_effects <- sem_params[sem_params$op == ":=", ]
print(indirect_effects[, c("lhs", "est", "std.all", "pvalue")])

# R-squared values for endogenous variables
cat("\n=== R-SQUARED VALUES FOR ENDOGENOUS VARIABLES ===\n")
r_squared <- inspect(fit_sem, "r2")
print(round(r_squared, 3))

