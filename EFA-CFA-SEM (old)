# -----------------------------------------------------------------------------
# 1.1 EFA FOR INTRINSIC RELIGIOSITY (IR) SCALE
# -----------------------------------------------------------------------------
cat("\n=== 1.1 EFA FOR INTRINSIC RELIGIOSITY (IR) SCALE ===\n")

if(all(c("IR1", "IR2", "IR3") %in% colnames(data_all))) {
  ir_items <- c("IR1", "IR2", "IR3")
  ir_data <- data_all[, ir_items]
  ir_data_complete <- na.omit(ir_data)
  
  cat("Sample size for IR EFA:", nrow(ir_data_complete), "\n")
  
  if(nrow(ir_data_complete) > 50) {
    # Check correlation matrix suitability
    cor_matrix_ir <- cor(ir_data_complete)
    KMO_ir <- KMO(cor_matrix_ir)
    cat("KMO Measure of Sampling Adequacy:", round(KMO_ir$MSA, 3), "\n")
    
    bartlett_ir <- cortest.bartlett(cor_matrix_ir, n = nrow(ir_data_complete))
    cat("Bartlett's test of sphericity: p =", format.pval(bartlett_ir$p.value, digits = 3), "\n")
    
    # Since IR has only 3 items, we'll check if it forms one factor
    eigen_ir <- eigen(cor_matrix_ir)$values
    cat("Eigenvalues:", round(eigen_ir, 3), "\n")
    cat("Number of eigenvalues > 1:", sum(eigen_ir > 1), "\n")
    
    # Reliability
    cat("\nReliability Analysis for IR Scale:\n")
    print(psych::alpha(ir_data_complete))
    
  } else {
    cat("Insufficient sample size for IR EFA\n")
  }
} else {
  cat("IR items not available for EFA\n")
}

# -----------------------------------------------------------------------------
# 1.2 EFA FOR ANTHROPOMORPHISM (IDAQ) SCALE
# -----------------------------------------------------------------------------
cat("\n=== 1.2 EFA FOR ANTHROPOMORPHISM (IDAQ) SCALE ===\n")

if(all(paste0("IDAQ", 1:15) %in% colnames(data_all))) {
  idaq_items <- paste0("IDAQ", 1:15)
  idaq_data <- data_all[, idaq_items]
  
  # Convert to numeric and handle missing values
  idaq_data <- as.data.frame(lapply(idaq_data, function(x) as.numeric(x)))
  idaq_data_complete <- na.omit(idaq_data)
  
  cat("Sample size for IDAQ EFA:", nrow(idaq_data_complete), "\n")
  
  if(nrow(idaq_data_complete) > 100) {
    # Check correlation matrix suitability
    cor_matrix_idaq <- cor(idaq_data_complete)
    KMO_idaq <- KMO(cor_matrix_idaq)
    cat("KMO Measure of Sampling Adequacy:", round(KMO_idaq$MSA, 3), "\n")
    
    bartlett_idaq <- cortest.bartlett(cor_matrix_idaq, n = nrow(idaq_data_complete))
    cat("Bartlett's test of sphericity: p =", format.pval(bartlett_idaq$p.value, digits = 3), "\n")
    
    # Determine number of factors using parallel analysis
    cat("Using parallel analysis for factor number determination\n")
    fa_parallel_idaq <- fa.parallel(idaq_data_complete, fa = "fa", plot = TRUE, 
                                    main = "Parallel Analysis Scree Plot - IDAQ")
    n_factors_idaq <- fa_parallel_idaq$nfact
    cat("Suggested number of factors from parallel analysis:", n_factors_idaq, "\n")
    
    # Also check eigenvalues > 1 (Kaiser criterion)
    eigen_idaq <- eigen(cor_matrix_idaq)$values
    cat("Eigenvalues:", round(eigen_idaq, 3), "\n")
    cat("Number of eigenvalues > 1:", sum(eigen_idaq > 1), "\n")
    
    # Perform EFA with suggested number of factors
    cat("Using", n_factors_idaq, "factors for IDAQ EFA\n")
    
    efa_idaq <- fa(idaq_data_complete, nfactors = n_factors_idaq, rotate = "oblimin", fm = "ml")
    print(efa_idaq, digits = 3, sort = TRUE)
    
    # Factor loadings plot
    fa.diagram(efa_idaq, main = paste("EFA Factor Structure for IDAQ -", n_factors_idaq, "Factors"))
    
    # Reliability for the full scale
    cat("\nReliability Analysis for Full IDAQ Scale:\n")
    print(psych::alpha(idaq_data_complete))
    
  } else {
    cat("Insufficient sample size for IDAQ EFA\n")
  }
} else {
  cat("IDAQ items not available for EFA\n")
}

