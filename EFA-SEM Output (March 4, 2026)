> # MAIN MODEL WITH LABELS FOR MEDIATION
> sem_model <- '
+   # ================= MEASUREMENT MODEL =================
+   Anthro_Technology =~ IDAQ7 + IDAQ9 + IDAQ4 + IDAQ5 + IDAQ1
+   Anthro_Nature     =~ IDAQ15 + IDAQ10 + IDAQ6 + IDAQ12 + IDAQ2
+   Anthro_Animals    =~ IDAQ8 + IDAQ11 + IDAQ14 + IDAQ13 + IDAQ3
+   Intrinsic_Relig   =~ IR1 + IR2 + IR3
+ 
+   # ================= STRUCTURAL PATHS TO MEDIATORS =================
+   Anthro_Technology ~ a1 * Intrinsic_Relig
+   Anthro_Nature     ~ a2 * Intrinsic_Relig
+   Anthro_Animals    ~ a3 * Intrinsic_Relig
+   
+   # ================= PATHS TO POSITIVE PERCEPTIONS =================
+   RobotPositivePerceptions ~ b1pos * Anthro_Technology + 
+                              b2pos * Anthro_Nature + 
+                              b3pos * Anthro_Animals
+                              
+   # ================= PATHS TO COMPETENCE =================
+   RobotCompetencePerceptions ~ b1comp * Anthro_Technology + 
+                                b2comp * Anthro_Nature + 
+                                b3comp * Anthro_Animals
+   
+   # ================= INDIRECT EFFECTS (POSITIVE) =================
+   ind_tech_pos    := a1 * b1pos
+   ind_nature_pos  := a2 * b2pos
+   ind_animals_pos := a3 * b3pos
+   tot_ind_pos     := ind_tech_pos + ind_nature_pos + ind_animals_pos
+ 
+   # ================= INDIRECT EFFECTS (COMPETENCE) =================
+   ind_tech_comp    := a1 * b1comp
+   ind_nature_comp  := a2 * b2comp
+   ind_animals_comp := a3 * b3comp
+   tot_ind_comp     := ind_tech_comp + ind_nature_comp + ind_animals_comp
+   
+   # ================= COVARIANCES =================
+   Anthro_Technology ~~ Anthro_Nature
+   Anthro_Technology ~~ Anthro_Animals
+   Anthro_Nature     ~~ Anthro_Animals
+   
+   # Allow the two dependent variables to covary
+   RobotPositivePerceptions ~~ RobotCompetencePerceptions
+ '
